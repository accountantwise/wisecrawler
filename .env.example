# Port the API listens on (default: 3002)
PORT=3002

# Redis connection string (default points to the docker-compose redis service)
REDIS_URL=redis://redis:6379/0

# Playwright navigation timeout in milliseconds (default: 30000)
PLAYWRIGHT_TIMEOUT=30000

# Max simultaneous Playwright pages in the API process (default: 5)
MAX_CONCURRENCY=5

# Optional Bearer token for API authentication. Leave empty to disable auth.
API_KEY=
