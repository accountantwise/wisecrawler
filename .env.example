# Port the API listens on (default: 3002)
PORT=3002

# Redis connection string (default points to the docker-compose redis service)
# If REDIS_PASSWORD is set, include it here: redis://:yourpassword@redis:6379/0
REDIS_URL=redis://redis:6379/0

# Optional Redis password. Leave empty to run without auth (default).
# If set, update REDIS_URL above to include the password.
REDIS_PASSWORD=

# Playwright navigation timeout in milliseconds (default: 30000)
PLAYWRIGHT_TIMEOUT=30000

# Max simultaneous Playwright pages in the API process (default: 5)
MAX_CONCURRENCY=5

# Optional Bearer token for API authentication. Leave empty to disable auth.
API_KEY=

# ---------------------------------------------------------------------------
# AI Analysis / Summarization
# ---------------------------------------------------------------------------

# Provider to use: openai | anthropic | gemini | openrouter (default: openai)
AI_PROVIDER=openai

# Model name. Leave empty to use the provider default:
#   openai      → gpt-4o-mini
#   anthropic   → claude-3-5-haiku-20241022
#   gemini      → gemini-1.5-flash
#   openrouter  → openai/gpt-4o-mini
AI_MODEL=

# API keys — only the key for your chosen provider is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Maximum characters per page before token counting (crawl/analyze, default: 100000)
AI_MAX_TOKENS_INPUT=100000

# Maximum number of crawled pages to aggregate for crawl/analyze (default: 50)
AI_MAX_PAGES=50

# System prompt used by /v1/scrape/summarize. Leave empty to use the built-in default.
AI_SUMMARIZE_PROMPT=

# ---------------------------------------------------------------------------
# Search (Brave Search API)
# ---------------------------------------------------------------------------

# Brave Search API key — get one at https://brave.com/search/api/
# Free tier: 2,000 queries/month. Required for POST /v1/search.
BRAVE_API_KEY=
